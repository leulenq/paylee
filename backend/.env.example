# Copy to .env and adjust. Defaults in app/config.py work for local development.
ENVIRONMENT=development
DATABASE_URL=postgresql://swipebills:swipebills@127.0.0.1:5433/swipebills
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Change SESSION_SECRET in production. Shared ADMIN_PASSWORD works only in development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-session-secret-not-for-production
ADMIN_PASSWORD=admin
ALLOW_DEV_LOGIN=true

APPLE_BUNDLE_ID=enquanhone.SwipeBills

# "fake" settles payments instantly with no money moving. "stripe" uses Stripe Checkout.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# "console" prints requester emails to the server log. "smtp" sends them through any SMTP provider.
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

MAX_LIVE_BILLS=50

# Production requires a written approved funding program and separately migrated database.
# These declarations do not obtain regulatory approval or open a segregated bank account.
LIVE_PAYMENTS_APPROVED=false
FUNDS_PROGRAM_REFERENCE=
SCHEMA_AUTO_APPLY=true

# Stable independent secrets: share between API, worker, and provisioning process.
# Generate DATA_ENCRYPTION_KEY with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep ACCOUNT_FINGERPRINT_KEY stable; rotating it requires a reviewed fingerprint migration.
DATA_ENCRYPTION_KEY=
ACCOUNT_FINGERPRINT_KEY=

# "local" is encrypted local development storage; production requires "s3" + private KMS bucket.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_KMS_KEY_ID=
AWS_REGION=us-east-1

# Start the worker separately: uv run python -m app.worker
# "clamav" fails closed unless a local clamscan binary or a private clamd is available.
# "development" bypasses actual scanning and is rejected in production.
MALWARE_SCANNER=clamav
CLAMSCAN_PATH=clamscan
CLAMD_HOST=
CLAMD_PORT=3310
# "manual" requires human extraction; "textract" uses the AWS credential chain.
OCR_PROVIDER=manual
VERIFICATION_HOURS=48
RELEASE_BALANCE_MINUTES=15
STAFF_SESSION_HOURS=8
